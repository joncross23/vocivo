{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@vocivo/contracts": ["packages/contracts/src/index.ts"],
      "@vocivo/domain": ["packages/domain/src/index.ts"],
      "@vocivo/application": ["packages/application/src/index.ts"],
      "@vocivo/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@vocivo/content-pipeline": ["packages/content-pipeline/src/index.ts"],
      "@vocivo/ui": ["packages/ui/src/index.ts"],
      "@vocivo/testkit": ["packages/testkit/src/index.ts"]
    }
  }
}
